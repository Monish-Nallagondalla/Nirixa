# My-OS Secrets & Tokens Configuration

# Telegram Bot API Token (Get this from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID / Chat ID (Populated automatically or set manually)
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Calendar Secret / Public iCal Feed URL
# To get your Google Calendar iCal URL: Google Calendar -> Settings -> Integrate Calendar -> Public/Secret address in iCal format
GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
