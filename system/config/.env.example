# Nirixa OS Configuration & Secrets

# 1. Telegram Mobile Gateway (Required for mobile bridge)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your numerical chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# 2. LLM Provider API Keys (Optional - choose your preferred model provider)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. Google Calendar Integration (Optional)
# In Google Calendar: Settings -> Integrate Calendar -> Secret/Public address in iCal format
GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
