# Nirixa OS - Environment Configuration Template
# Rename this file to '.env' and fill in your credentials.

# Telegram Bot Credentials (Obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_AUTHORIZED_CHAT_ID="your_telegram_chat_id_here"
TELEGRAM_API_BASE_URL="https://api.telegram.org"

# Gemini API Key (Obtain from Google AI Studio)
GEMINI_API_KEY="your_gemini_api_key_here"

# System Settings
NIRIXA_ENV="development"
LOG_LEVEL="INFO"
